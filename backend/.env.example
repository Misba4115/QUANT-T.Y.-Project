QUANT_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Runtime database (service-role key stays on the backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# SUPABASE_KEY may be used only for a deliberately RLS-backed client.

# Authentication
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=quant_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=

# Chat model
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Public curated knowledge base (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=quant_public_knowledge_v1
QDRANT_VECTOR_SIZE=384

# Market data and uploads
MARKET_DATA_TIMEOUT_SECONDS=8
COINGECKO_API_KEY=
CREDENTIAL_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:3000
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/connectors/upstox/callback
INBOX_WEBHOOK_SECRET=
INBOX_DOMAIN=inbox.quant.local
EXPORT_SIGNING_SECRET=
WORKER_POLL_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=10000
