# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/quant_db

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── LLM / Gemini (AI Studio) ───────────────────────────────────────────────
# This project uses Google AI Studio's free API.  Obtain a key from
# https://aistudio.google.com/app/apikey and set GEMINI_API_KEY accordingly.
# The library `google-genai` is used under the hood (the old
# `google-generativeai` package is deprecated and should not be used).
# ``LLM_PROVIDER`` defaults to "gemini"; set to "openai" to use the OpenAI
# fallback (requires an OPENAI_API_KEY).
GEMINI_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash        # or another supported Gemini model
LLM_PROVIDER=gemini

# (Optional) OpenAI key for fallback
OPENAI_API_KEY=sk-...

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── External APIs (optional) ──────────────────────────────────────────────────
COINGECKO_API_KEY=                # leave empty for free tier
